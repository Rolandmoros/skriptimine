#!/bin/bash
#
# Algarvu tuvastamine
#
echo -n "Sisesta suvaline arv: "
read arv

if [ $arv -lt 2 ]; then
    echo "$arv - ei ole algarv"
else
    jagaja=2
    jaak=$(( arv % jagaja ))
    while [ $jaak -ne 0 ]
    do
        jagaja=$(( jagaja + 1 ))
        jaak=$(( arv % jagaja ))
    done
    if [ $arv -eq $jagaja ]; then
        echo "$arv - on algarv"
    else
        echo "$arv - ei ole algarv"
    fi
fi
