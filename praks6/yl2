#!/bin/bash
#
# Sisestatud taisarvu numbrite summa arvutamine
#
echo -n "Sisesta suvaline täisarv: "
read arv
algne=$arv

# negatiivse arvu korral votame absoluutvaartuse
if [ $arv -lt 0 ]; then
    arv=$(( -arv ))
fi

summa=0
while [ $arv -ne 0 ]
do
    jaak=$(( arv % 10 ))
    summa=$(( summa + jaak ))
    arv=$(( arv / 10 ))
done
echo "Arvu $algne numbrite summa on $summa"
