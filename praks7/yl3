#!/bin/bash
#
# Valjastab ristkuliku, mille servad koosnevad tarnidest
# ja sisemus on tuhi
#
echo -n "Sisesta ridade arv: "
read read_arv
echo -n "Sisesta tarnide arv reas: "
read tarnide_arv

for (( i=1; i<=read_arv; i++ ))
do
    echo -n "$i. "
    for (( j=1; j<=tarnide_arv; j++ ))
    do
        # esimene ja viimane rida ning esimene ja viimane veerg - tarn
        if [ $i -eq 1 ] || [ $i -eq $read_arv ] || [ $j -eq 1 ] || [ $j -eq $tarnide_arv ]; then
            echo -n "* "
        else
            echo -n "  "
        fi
    done
    echo ""
done
