#!/bin/bash
#
# Kasutaja sisestab ridade arvu ja tarnide arvu reas,
# skript valjastab vastava kujundi
#
echo -n "Sisesta ridade arv: "
read read_arv
echo -n "Sisesta tarnide arv reas: "
read tarnide_arv

for (( i=1; i<=read_arv; i++ ))
do
    echo -n "$i. "
    for (( j=1; j<=tarnide_arv; j++ ))
    do
        echo -n "* "
    done
    echo ""
done
